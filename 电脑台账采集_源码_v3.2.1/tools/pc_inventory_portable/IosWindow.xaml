<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PcInventory.Ios;assembly=电脑台账采集"
      Background="#F5F5F7" TextElement.FontFamily="Microsoft YaHei UI" TextElement.Foreground="#1D1D1F">
  <Grid.Resources>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#6E6E73"/><Setter Property="Margin" Value="1,0,0,7"/></Style>
    <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Subtext" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#86868B"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#FAFAFC"/><Setter Property="Foreground" Value="#1D1D1F"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#F0F0F3"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="RowHeight" Value="48"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F5F5F7"/><Setter Property="Foreground" Value="#6E6E73"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="FontSize" Value="12"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E8F2FF"/><Setter Property="Foreground" Value="#005FC5"/></Trigger></Style.Triggers></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="Transparent" Margin="18,0,10,0">
    <TextBlock Text="电脑台账" FontSize="11" Foreground="#86868B" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button x:Name="Minimize" Style="{StaticResource WindowButton}" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M0,4 L10,4" Stroke="#6E6E73" StrokeThickness="1.3"/></Button>
      <Button x:Name="Maximize" Style="{StaticResource WindowButton}" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原"><Rectangle Width="9" Height="9" Stroke="#6E6E73" StrokeThickness="1.2" RadiusX="1" RadiusY="1"/></Button>
      <Button x:Name="CloseWindow" Style="{StaticResource WindowButton}" ToolTip="关闭" AutomationProperties.Name="关闭"><Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#6E6E73" StrokeThickness="1.3"/></Button>
    </StackPanel>
  </Grid>
  <Grid Grid.Row="1" x:Name="Workspace">
    <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#EDF0F5" CornerRadius="0,20,0,0" Margin="0,6,0,0" Padding="18,26,18,20">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Border Width="48" Height="48" HorizontalAlignment="Left" Background="#007AFF" CornerRadius="14" Margin="3,0,0,17"><Viewbox Width="26" Height="26"><Path Data="M3,3 L21,3 Q23,3 23,5 L23,16 Q23,18 21,18 L3,18 Q1,18 1,16 L1,5 Q1,3 3,3 M12,18 L12,23 M7,23 L17,23" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Border>
          <TextBlock Text="电脑台账" FontSize="21" FontWeight="Bold" Margin="2,0,0,5"/>
          <TextBlock Text="随盘携带 · 资料留在本地" FontSize="10" Foreground="#86868B" Margin="2,0,0,31"/>
          <ToggleButton x:Name="NavCollect" Style="{StaticResource NavButton}" IsChecked="True" Margin="0,0,0,9" AutomationProperties.Name="设备采集"><StackPanel Orientation="Horizontal"><Path Data="M2,2 L18,2 18,14 2,14 Z M10,14 L10,18 M6,18 L14,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="20" Height="20" StrokeThickness="1.6" Margin="0,0,11,0"/><TextBlock Text="设备采集" VerticalAlignment="Center"/></StackPanel></ToggleButton>
          <ToggleButton x:Name="NavHistory" Style="{StaticResource NavButton}" Margin="0,0,0,9" AutomationProperties.Name="历史记录"><StackPanel Orientation="Horizontal"><Path Data="M3,2 L17,2 17,18 3,18 Z M7,7 L13,7 M7,11 L13,11 M7,15 L11,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="20" Height="20" StrokeThickness="1.6" Margin="0,0,11,0"/><TextBlock Text="历史记录" VerticalAlignment="Center"/></StackPanel></ToggleButton>
          <ToggleButton x:Name="NavBackup" Style="{StaticResource NavButton}" Margin="0,0,0,9" AutomationProperties.Name="备份与恢复"><StackPanel Orientation="Horizontal"><Path Data="M10,1 L18,4 17,12 Q16,16 10,20 Q4,16 3,12 L2,4 Z M6,10 L9,13 14,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="20" Height="21" StrokeThickness="1.6" Margin="0,0,11,0"/><TextBlock Text="备份与恢复" VerticalAlignment="Center"/></StackPanel></ToggleButton>
          <ToggleButton x:Name="NavAbout" Style="{StaticResource NavButton}" AutomationProperties.Name="关于"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,11,0"><Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6" Margin="1"/><Path Data="M10,9 L10,15 M10,5 L10,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8"/></Grid><TextBlock Text="关于" VerticalAlignment="Center"/></StackPanel></ToggleButton>
        </StackPanel>
        <Border Grid.Row="2" Background="#E3E8F0" CornerRadius="13" Padding="13,14"><StackPanel><TextBlock Text="●  离线运行" Foreground="#248A3D" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="换电脑时，请携带&#10;整个工具文件夹。" FontSize="11" Foreground="#6E6E73" LineHeight="19"/></StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" x:Name="MainWorkspace" Margin="28,14,28,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20"><StackPanel><TextBlock x:Name="PageTitle" Text="设备采集" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="PageDescription" Text="读取电脑信息，补充现场情况，然后保存。" Foreground="#86868B" FontSize="12" Margin="1,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12" Background="#E7F4EC" Padding="12,7" Margin="0,9,0,0"><TextBlock Text="本地保存" Foreground="#248A3D" FontSize="11" FontWeight="SemiBold"/></Border></Grid>
      <Grid x:Name="GlobalStats" Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="17,13" Margin="0,0,10,0"><Grid><StackPanel><TextBlock Text="当前记录" Style="{StaticResource Subtext}"/><TextBlock x:Name="RecordCount" Text="0 条" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><Border Width="36" Height="36" Background="#EAF3FF" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Center"><Path Data="M0,2 Q0,-1 8,-1 Q16,-1 16,2 Q16,5 8,5 Q0,5 0,2 L0,14 Q0,17 8,17 Q16,17 16,14 L16,2 M0,8 Q0,11 8,11 Q16,11 16,8" Stroke="#007AFF" StrokeThickness="1.4" Width="18" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="17,13" Margin="0,0,10,0"><StackPanel><TextBlock Text="每次保存" Style="{StaticResource Subtext}"/><TextBlock Text="追加一条新记录" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17,13"><StackPanel><TextBlock Text="数据保护" Style="{StaticResource Subtext}"/><TextBlock x:Name="BackupState" Text="自动保留每次备份" FontSize="14" FontWeight="SemiBold" Foreground="#248A3D" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
      </Grid>
      <Grid x:Name="PageHost" Grid.Row="2" ClipToBounds="True">
        <Grid x:Name="CollectPage"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="CollectionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,1,0" Focusable="False">
            <Grid x:Name="CollectionCards"><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border x:Name="ManualCard" Style="{StaticResource Card}" Padding="20" Margin="0,0,14,0"><StackPanel>
                <TextBlock Text="现场信息" Style="{StaticResource CardTitle}"/><TextBlock Text="带 * 的项目必填，不清楚可填“待核实”。" Style="{StaticResource Subtext}" Margin="0,7,0,21"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,17"><TextBlock Text="位置 *" Style="{StaticResource Caption}"/><TextBox x:Name="Location" TabIndex="0" Tag="例如：综合楼 302 室" AutomationProperties.Name="位置"/></StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,0,0,17"><TextBlock Text="实际使用人 *" Style="{StaticResource Caption}"/><TextBox x:Name="Person" TabIndex="2" AutomationProperties.Name="实际使用人"/></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,17"><TextBlock Text="资产编号 · 选填" Style="{StaticResource Caption}"/><TextBox x:Name="Number" TabIndex="3" AutomationProperties.Name="资产编号"/></StackPanel>
                  <StackPanel Grid.Row="2" Margin="0,0,0,17"><TextBlock Text="电脑类型" Style="{StaticResource Caption}"/><ComboBox x:Name="DeviceType" TabIndex="4" AutomationProperties.Name="电脑类型"/></StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,17"><TextBlock Text="设备状态" Style="{StaticResource Caption}"/><ComboBox x:Name="DeviceState" TabIndex="5" AutomationProperties.Name="设备状态"/></StackPanel>
                  <StackPanel Grid.Row="3" Margin="0,0,0,14"><TextBlock Text="取得日期 · 选填" Style="{StaticResource Caption}"/><local:IosDateField x:Name="Acquired" TabIndex="6" AutomationProperties.Name="取得日期"/></StackPanel>
                  <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14"><TextBlock Text="备注 · 选填" Style="{StaticResource Caption}"/><TextBox x:Name="Remarks" TabIndex="7" AutomationProperties.Name="备注"/></StackPanel>
                </Grid>
                <TextBlock Text="公用电脑填“公用”；日期未知就留空。" Style="{StaticResource Subtext}" FontSize="11" Margin="0,2,0,0"/>
              </StackPanel></Border>
              <Border x:Name="HardwareCard" Grid.Column="1" Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="本机硬件" Style="{StaticResource CardTitle}"/><TextBlock Text="自动读取，保存前请核对。" Style="{StaticResource Subtext}" Margin="0,7,0,21"/>
                <Border Background="#F0F6FF" CornerRadius="14" Padding="14,15" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M2,2 L26,2 Q28,2 28,4 L28,19 Q28,21 26,21 L2,21 Q0,21 0,19 L0,4 Q0,2 2,2 M14,21 L14,27 M8,27 L20,27" Stroke="#007AFF" StrokeThickness="1.6" Width="30" Height="28" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock x:Name="ModelTitle" Text="等待读取电脑" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ModelHint" Text="只读采集 · 不修改设置" FontSize="11" Foreground="#6E6E73" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
                <ItemsControl x:Name="HardwareRows"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#F0F0F3" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontSize="11" Foreground="#86868B"/><TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" TextWrapping="Wrap" Foreground="#3A3A3C"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel></Border>
            </Grid>
          </ScrollViewer>
          <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="Save" Style="{StaticResource PrimaryButton}" Width="186" TabIndex="8" AutomationProperties.Name="保存并追加一条"><StackPanel Orientation="Horizontal"><Path Data="M2,1 L14,1 18,5 18,18 1,18 1,1 Z M5,1 L5,7 13,7 13,1 M5,18 L5,12 14,12 14,18" Stroke="White" StrokeThickness="1.5" Width="20" Height="20" Margin="0,0,9,0"/><TextBlock x:Name="SaveText" Text="保存并追加一条" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="Refresh" Grid.Column="1" Width="116" Margin="10,0,0,0" TabIndex="9" Content="重新读取"/>
            <Button x:Name="Summary" Grid.Column="2" Width="150" Margin="10,0,0,0" TabIndex="10" Content="打开 / 更新总表"/>
          </Grid>
        </Grid>
        <Border x:Name="HistoryPage" Style="{StaticResource Card}" Padding="20" Visibility="Collapsed">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="台账记录" Style="{StaticResource CardTitle}"/><TextBlock Text="选中一条，查看详情或删除。" Style="{StaticResource Subtext}" Margin="0,6,0,0"/></StackPanel>
              <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="HistoryFilter" Tag="搜索编号 / 序列号 / 位置" AutomationProperties.Name="搜索历史记录" ToolTip="输入编号、序列号、位置或使用人。Ctrl+F 搜索，Esc 清空。"/>
                <Button x:Name="ClearHistoryFilter" Grid.Column="1" Content="×" Style="{StaticResource QuietButton}" Width="30" Height="36" Padding="0" Margin="6,0,0,0" FontSize="20" Visibility="Collapsed" ToolTip="清空搜索" AutomationProperties.Name="清空搜索"/>
              </Grid>
            </Grid>
            <DockPanel Grid.Row="1" Margin="0,0,0,15" LastChildFill="False">
              <Button x:Name="PreviewRecord" Content="预览详情" Width="112" Height="38" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" AutomationProperties.Name="预览所选记录"/>
              <Button x:Name="DeleteRecord" Content="删除记录" Width="112" Height="38" Background="#FFF1F0" Foreground="#D92D20" BorderBrush="#FFE1DF" AutomationProperties.Name="删除所选记录"/>
              <Button x:Name="HistorySummary" Content="打开台账" Width="112" Height="38" Margin="10,0,0,0" ToolTip="打开当前选中的 Excel 台账" AutomationProperties.Name="打开当前台账"/>
              <Button x:Name="RefreshHistory" DockPanel.Dock="Right" Content="刷新" Height="38" Width="76" Style="{StaticResource QuietButton}" AutomationProperties.Name="刷新历史记录"/>
            </DockPanel>
            <Grid Grid.Row="2">
              <DataGrid x:Name="History" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"><DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="55" MinWidth="55"/><DataGridTextColumn Header="设备编号" Binding="{Binding Number}" Width="105" MinWidth="105"/><DataGridTextColumn Header="整机序列号" Binding="{Binding Serial}" Width="140" MinWidth="140"/><DataGridTextColumn Header="品牌型号" Binding="{Binding Model}" Width="*" MinWidth="140"/><DataGridTextColumn Header="位置" Binding="{Binding Location}" Width="160" MinWidth="120"/><DataGridTextColumn Header="使用人" Binding="{Binding Person}" Width="90" MinWidth="90"/><DataGridTextColumn Header="采集时间" Binding="{Binding Time}" Width="145" MinWidth="145"/></DataGrid.Columns></DataGrid>
              <Border x:Name="HistoryEmpty" Background="#FAFAFC" CornerRadius="12" Margin="0,45,0,0" IsHitTestVisible="False"><TextBlock x:Name="HistoryEmptyText" Text="还没有记录，采集保存后会显示在这里。" FontSize="12" Foreground="#929299" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/></Border>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,13,0,0"><TextBlock x:Name="HistoryCount" Text="当前共有 0 条记录" Foreground="#6E6E73" FontSize="12"/><TextBlock x:Name="HistorySync" Text="表格删除整行并保存后，会自动同步。" FontSize="11" Foreground="#86868B" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/></StackPanel>
          </Grid>
        </Border>
        <ScrollViewer x:Name="BackupPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource Card}" Padding="26"><StackPanel>
          <TextBlock Text="让每一次采集，都安心留存。" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="每次保存、每次删除前，都会为当前台账保留备份。" Style="{StaticResource Subtext}" Margin="0,10,0,26"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#F5F8FE" CornerRadius="16" Padding="18"><StackPanel><TextBlock Text="01" FontSize="26" Foreground="#007AFF" FontWeight="SemiBold"/><TextBlock Text="追加原始记录" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,7"/><TextBlock Text="每次保存单独留存&#10;不会覆盖之前的记录" Style="{StaticResource Subtext}"/></StackPanel></Border>
            <Border Grid.Column="2" Background="#F5F8FE" CornerRadius="16" Padding="18"><StackPanel><TextBlock Text="02" FontSize="26" Foreground="#007AFF" FontWeight="SemiBold"/><TextBlock Text="更新总表" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,7"/><TextBlock Text="全部记录依次排列&#10;随时打开查看" Style="{StaticResource Subtext}"/></StackPanel></Border>
            <Border Grid.Column="4" Background="#EEF8F2" CornerRadius="16" Padding="18"><StackPanel><TextBlock Text="03" FontSize="26" Foreground="#248A3D" FontWeight="SemiBold"/><TextBlock Text="新建完整备份" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,7"/><TextBlock Text="独立命名，保留旧版&#10;需要时可恢复" Style="{StaticResource Subtext}"/></StackPanel></Border>
          </Grid>
          <Border Background="#FFF8EC" CornerRadius="13" Padding="16" Margin="0,22,0,21"><TextBlock Text="建议每天另备份到单位电脑或另一块盘。同一 U 盘里的备份，无法防止 U 盘丢失或损坏。" Foreground="#916419" FontSize="12" TextWrapping="Wrap" LineHeight="21"/></Border>
          <WrapPanel><Button x:Name="Backup" Style="{StaticResource PrimaryButton}" Content="另存备份到其他盘" Padding="18,0" Margin="0,0,10,10"/><Button x:Name="Restore" Content="从备份恢复" Padding="18,0" Margin="0,0,10,10"/><Button x:Name="OpenBackups" Content="打开备份文件夹" Padding="18,0" Margin="0,0,0,10"/></WrapPanel>
          <TextBlock Text="恢复时会新建文件夹，现有记录保持不变。&#10;在当前表格中删除整行并保存，程序会自动同步。" Style="{StaticResource Subtext}" Margin="0,11,0,0" LineHeight="22"/>
        </StackPanel></Border></ScrollViewer>
        <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,1,0" Focusable="False">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Image x:Name="DeveloperAvatar" Width="76" Height="76" Stretch="UniformToFill" HorizontalAlignment="Left" AutomationProperties.Name="开发者头像"><Image.Clip><EllipseGeometry Center="38,38" RadiusX="38" RadiusY="38"/></Image.Clip></Image>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="电脑台账" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="DeveloperMark" Text="开发者：CBY · Alu" FontSize="13" Foreground="#515157" Margin="0,7,0,0"/><TextBlock Text="离线采集 · 本地保存 · 随盘携带" Style="{StaticResource Subtext}" Margin="0,6,0,0"/></StackPanel>
                </Grid>
                <WrapPanel Margin="0,20,0,0">
                  <Button x:Name="GitHubLink" Tag="https://github.com/CBY-Aluuu" Height="42" Padding="14,0" Margin="0,0,10,8" Foreground="#0066CC" Background="#F0F6FF" BorderBrush="#DCEBFF" Content="GitHub ↗  CBY-Aluuu" ToolTip="用默认浏览器访问 Alu 的 GitHub 主页" AutomationProperties.Name="访问开发者 GitHub 主页"/>
                  <Button x:Name="EmailLink" Tag="mailto:1140357618@qq.com" Height="42" Padding="14,0" Margin="0,0,0,8" Content="邮箱  1140357618@qq.com" ToolTip="使用默认邮件应用联系开发者" AutomationProperties.Name="联系开发者邮箱"/>
                </WrapPanel>
                <TextBlock Text="欢迎交流使用体验、反馈问题和提出建议。" Style="{StaticResource Subtext}" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="24">
              <StackPanel>
                <TextBlock Text="打赏支持" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="如果这个小工具帮到了你，欢迎自愿打赏。谢谢你的支持！" Style="{StaticResource Subtext}" Margin="0,7,0,18"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Background="#F3F8FF" CornerRadius="14" Padding="14"><StackPanel>
                    <TextBlock Text="支付宝" Foreground="#007AFF" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <Image x:Name="AlipayQr" Height="285" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="支付宝打赏二维码"/>
                    <Button x:Name="AlipayPreview" Content="放大二维码" Height="34" Style="{StaticResource QuietButton}" Foreground="#007AFF" Margin="0,10,0,0" AutomationProperties.Name="放大支付宝二维码"/>
                  </StackPanel></Border>
                  <Border Grid.Column="2" Background="#F0F9F4" CornerRadius="14" Padding="14"><StackPanel>
                    <TextBlock Text="微信支付" Foreground="#248A3D" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <Image x:Name="WechatQr" Height="285" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="微信打赏二维码"/>
                    <Button x:Name="WechatPreview" Content="放大二维码" Height="34" Style="{StaticResource QuietButton}" Foreground="#248A3D" Margin="0,10,0,0" AutomationProperties.Name="放大微信二维码"/>
                  </StackPanel></Border>
                </Grid>
                <TextBlock Text="使用支付宝或微信扫码；点击“放大二维码”可查看大图。" Style="{StaticResource Subtext}" TextAlignment="Center" Margin="0,16,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="3" x:Name="StatusPanel" Background="#EAF3FF" CornerRadius="13" Padding="14,12" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Fill="#007AFF" Width="7" Height="7"/><Path x:Name="Spinner" Data="M9,1 A8,8 0 1 1 1,9" Stroke="#007AFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path></Grid><TextBlock x:Name="Status" Grid.Column="1" Text="准备就绪" FontSize="12" Foreground="#245C98" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="StatusDetails" Grid.Column="2" Style="{StaticResource QuietButton}" Content="详情" Height="28" Padding="10,0" Margin="8,0,0,0" Visibility="Collapsed"/></Grid></Border>
      <Grid x:Name="WorkbookBar" Grid.Row="4" Margin="2,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="当前台账" FontSize="12" Foreground="#6E6E73" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <ComboBox x:Name="WorkbookPicker" Grid.Column="1" Height="38" AutomationProperties.Name="选择当前台账" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/>
        <Button x:Name="RefreshWorkbooks" Grid.Column="2" Content="刷新列表" Style="{StaticResource QuietButton}" Height="38" Margin="8,0,0,0" Padding="12,0" AutomationProperties.Name="刷新台账文件列表"/>
      </Grid>
    </Grid>
  </Grid>
</Grid>
